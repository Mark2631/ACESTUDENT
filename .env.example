NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Use the publishable key for new projects. The legacy anon key is also supported.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY
# Optional compatibility name for projects that still expose the older anon key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
